# Default deny: this checkout contains private local research artifacts.
# Only reviewed code, generic documentation and one blank layout are allowed.
/*
!/.gitignore
!/AGENTS.md
!/.gitattributes
!/README.md
!/pyproject.toml
!/requirements.lock.txt
!/dashboard.py
!/local_update_entry.py
!/config.example.json
!/*.command

!/study2/
/study2/*
!/study2/*.py
!/study2/presentation/
/study2/presentation/*
!/study2/presentation/*.py
!/study2/presentation/assets/
/study2/presentation/assets/*
!/study2/presentation/assets/app.js
!/study2/presentation/assets/app.css
!/study2/presentation/assets/quality.js
!/study2/presentation/assets/scope.js
!/study2/presentation/assets/local-preview.mjs
!/study2/assets/
/study2/assets/*
!/study2/assets/review_template.xlsx

!/tests/
/tests/*
!/tests/*.py
!/tests/static_source_ui_browser.cjs
!/tests/paired_table_ui_browser.cjs
!/tests/manual_exclusion_ui_browser.cjs

!/mappings/
/mappings/*
!/mappings/*.py

!/tools/
/tools/*
!/tools/repository_guard.py
!/tools/qa/
/tools/qa/*
!/tools/qa/synthetic_review.py
!/tools/qa/review_workbook.mjs

!/docs/
/docs/*
!/docs/DATA_MODEL.md
!/docs/STAGES.md
!/docs/REVIEW_CARDS_COLLEAGUES.md
!/docs/REVIEW_CARDS_OPERATIONS.md
!/docs/MATCHING_RULES.md
!/docs/CODE_READING_GUIDE.md
!/docs/REPOSITORY.md
!/docs/PORTABLE_WORKFLOW.md
!/docs/PROJECT_STATE.md
!/docs/DECISIONS.md
!/docs/portable-update-helpers.md
!/docs/presentation-boundary.md
!/docs/DYAD_TRACKING_OPERATIONS.md
!/docs/INDEPENDENT_PARENT_ANALYSIS.md
!/docs/DESCRIPTIVE_ANALYSIS.md
!/docs/STATIC_RESEARCHER_DASHBOARD.md

!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push

# Defense in depth, including files created inside allowed directories.
.venv*/
venv/
archives/
releases/
inbox/
review_packages/
data/
state/
