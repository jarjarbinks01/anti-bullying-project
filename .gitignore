# Default deny: this checkout contains private local research artifacts.
# Only reviewed code, generic documentation and one blank layout are allowed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/requirements.lock.txt
!/dashboard.py
!/config.example.json
!/*.command

!/study2/
/study2/*
!/study2/*.py
!/study2/assets/
/study2/assets/*
!/study2/assets/review_template.xlsx

!/tests/
/tests/*
!/tests/*.py

!/mappings/
/mappings/*
!/mappings/*.py

!/tools/
/tools/*
!/tools/repository_guard.py
!/tools/qa/
/tools/qa/*
!/tools/qa/synthetic_review.py
!/tools/qa/review_workbook.mjs

!/docs/
/docs/*
!/docs/DATA_MODEL.md
!/docs/STAGES.md
!/docs/REVIEW_CARDS_COLLEAGUES.md
!/docs/REVIEW_CARDS_OPERATIONS.md
!/docs/MATCHING_RULES.md
!/docs/REPOSITORY.md

!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push

# Defense in depth, including files created inside allowed directories.
.venv*/
venv/
archives/
releases/
inbox/
review_packages/
data/
state/
backups/
__pycache__/
.pytest_cache/
*.egg-info/
.DS_Store
.env*
*.pem
*.key
*.sqlite*
*.db
*.db-*
*.csv
*.tsv
*.parquet
*.jsonl
*.log
*.xlsx
*.xls
*.xlsm
*.png
*.jpg
*.jpeg
*.pdf
*.zip
*.pyc
config.local.json
config.merged.json
secrets.toml

# This exact, inspected blank template is code. Filled workbooks are excluded.
!/study2/assets/review_template.xlsx
